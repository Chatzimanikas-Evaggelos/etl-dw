{
	"name": "Error_Handling_Final",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "AzureSqlTable14",
						"type": "DatasetReference"
					},
					"name": "SOH"
				},
				{
					"dataset": {
						"referenceName": "AzureSqlTable15",
						"type": "DatasetReference"
					},
					"name": "SOD"
				},
				{
					"dataset": {
						"referenceName": "AzureSqlTable16",
						"type": "DatasetReference"
					},
					"name": "Customer"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "AzureSqlTable17",
						"type": "DatasetReference"
					},
					"name": "FactWrk"
				},
				{
					"dataset": {
						"referenceName": "AzureSqlTable18",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "SODSOH"
				},
				{
					"name": "lookup1",
					"description": "Lookup on 'SODSOH' from 'Customer'"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				},
				{
					"name": "select1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          SalesOrderID as string,",
				"          RevisionNumber as string,",
				"          OrderDate as string,",
				"          DueDate as string,",
				"          ShipDate as string,",
				"          Status as string,",
				"          OnlineOrderFlag as string,",
				"          SalesOrderNumber as string,",
				"          PurchaseOrderNumber as string,",
				"          AccountNumber as string,",
				"          CustomerID as string,",
				"          SalesPersonID as string,",
				"          TerritoryID as string,",
				"          BillToAddressID as string,",
				"          ShipToAddressID as string,",
				"          ShipMethodID as string,",
				"          CreditCardID as string,",
				"          CreditCardApprovalCode as string,",
				"          CurrencyRateID as string,",
				"          SubTotal as string,",
				"          TaxAmt as string,",
				"          Freight as string,",
				"          TotalDue as string,",
				"          Comment as string,",
				"          rowguid as string,",
				"          ModifiedDate as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> SOH",
				"source(output(",
				"          SalesOrderID as integer,",
				"          SalesOrderDetailID as integer,",
				"          CarrierTrackingNumber as string,",
				"          OrderQty as integer,",
				"          ProductID as integer,",
				"          SpecialOfferID as integer,",
				"          UnitPrice as decimal(19,4),",
				"          UnitPriceDiscount as decimal(19,4),",
				"          LineTotal as decimal(38,6),",
				"          rowguid as string,",
				"          ModifiedDate as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> SOD",
				"source(output(",
				"          CustomerKey as integer,",
				"          CustomerID as integer,",
				"          PersonID as integer,",
				"          StoreID as integer,",
				"          TerritoryID as integer,",
				"          CustomerType as string,",
				"          FirstName as string,",
				"          MiddleName as string,",
				"          LastName as string,",
				"          age as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> Customer",
				"SOH, SOD join(SOH@SalesOrderID == toString(SOD@SalesOrderID),",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> SODSOH",
				"SODSOH, Customer lookup(SOH@CustomerID == toString(Customer@CustomerID),",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup1",
				"lookup1 derive(FoundCustomer = !isNull(CustomerKey)) ~> derivedColumn1",
				"derivedColumn1 split(FoundCustomer,",
				"     disjoint: false) ~> split1@(ValidCustomerRows, MissingCustomerRows)",
				"split1@MissingCustomerRows select(mapColumn(",
				"          SalesOrderID = split1@MissingCustomerRows@SalesOrderID,",
				"          RevisionNumber,",
				"          OrderDate,",
				"          DueDate,",
				"          ShipDate,",
				"          Status,",
				"          OnlineOrderFlag,",
				"          SalesOrderNumber,",
				"          PurchaseOrderNumber,",
				"          AccountNumber,",
				"          CustomerID = split1@MissingCustomerRows@CustomerID,",
				"          SalesPersonID,",
				"          TerritoryID = split1@MissingCustomerRows@TerritoryID,",
				"          BillToAddressID,",
				"          ShipToAddressID,",
				"          ShipMethodID,",
				"          CreditCardID,",
				"          CreditCardApprovalCode,",
				"          CurrencyRateID,",
				"          SubTotal,",
				"          TaxAmt,",
				"          Freight,",
				"          TotalDue,",
				"          Comment,",
				"          rowguid = split1@MissingCustomerRows@rowguid,",
				"          ModifiedDate = split1@MissingCustomerRows@ModifiedDate,",
				"          SalesOrderID = split1@MissingCustomerRows@SalesOrderID,",
				"          SalesOrderDetailID,",
				"          CarrierTrackingNumber,",
				"          OrderQty,",
				"          ProductID,",
				"          SpecialOfferID,",
				"          UnitPrice,",
				"          UnitPriceDiscount,",
				"          LineTotal,",
				"          rowguid = split1@MissingCustomerRows@rowguid,",
				"          ModifiedDate = split1@MissingCustomerRows@ModifiedDate,",
				"          CustomerKey,",
				"          CustomerID = split1@MissingCustomerRows@CustomerID,",
				"          PersonID,",
				"          StoreID,",
				"          TerritoryID = split1@MissingCustomerRows@TerritoryID,",
				"          CustomerType,",
				"          FirstName,",
				"          MiddleName,",
				"          LastName,",
				"          age,",
				"          FoundCustomer",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"split1@ValidCustomerRows sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     recreate:true,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> FactWrk",
				"select1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ErrorID as integer,",
				"          SalesOrderID as integer,",
				"          SalesOrderDetailID as integer,",
				"          CustomerID as integer,",
				"          ErrorDescription as string,",
				"          ErrorDate as timestamp",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     truncate:true,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}